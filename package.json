{
  "name": "markov-constraints",
  "version": "0.4.0-rc.1",
  "type": "module",
  "description": "Exact controlled generation for variable-order Markov models",
  "license": "MIT",
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "docs/api.md",
    "CHANGELOG.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/core/src/index.d.ts",
      "import": "./dist/core/src/index.js"
    },
    "./constraints": {
      "types": "./dist/constraints/src/index.d.ts",
      "import": "./dist/constraints/src/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test tests/*.test.mjs",
    "examples": "node examples/domains.mjs",
    "benchmark": "node benchmarks/run.mjs",
    "playground": "python3 -m http.server 8080 --bind 127.0.0.1",
    "prepack": "npm run build",
    "build:site": "npm run build && node scripts/build_site.mjs",
    "test:package": "node scripts/check_package.mjs",
    "test:browser": "npm run build:site && playwright test",
    "benchmark:realistic": "npm run build && node benchmarks/realistic.mjs",
    "examples:rich": "npm run build && node examples/rich.mjs",
    "benchmark:patterns": "npm run build && node benchmarks/patterns.mjs",
    "benchmark:sampling": "npm run build && node --expose-gc benchmarks/sampling.mjs",
    "benchmark:memory": "npm run build && node benchmarks/memory.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "typescript": "^5.9.0"
  },
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fpachet/vo_bp_regular_ts.git"
  },
  "homepage": "https://fpachet.github.io/vo_bp_regular_ts/",
  "bugs": {
    "url": "https://github.com/fpachet/vo_bp_regular_ts/issues"
  },
  "keywords": [
    "markov",
    "variable-order",
    "constraints",
    "exact-sampling",
    "typescript"
  ]
}
